# Normalise line endings so the repository is identical on Windows, macOS and
# Linux, and so binary assets are never mangled by autocrlf.
* text=auto eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.webmanifest text eol=lf

*.png binary
*.ico binary
*.woff binary
*.woff2 binary